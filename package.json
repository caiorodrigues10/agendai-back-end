{
  "name": "agendai-backend",
  "version": "1.0.0",
  "main": "dist/shared/infra/http/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/shared/infra/http/server.ts",
    "dev:docker": "tsx watch src/shared/infra/http/server.ts",
    "build": "tsup src --out-dir dist",
    "start": "node dist/shared/infra/http/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run --exclude src/tests/integration/**",
    "test:integration": "dotenv -e .env -- env DATABASE_URL=postgresql://agendai:agendai123@localhost:5442/agendai_db NODE_ENV=test vitest run src/tests/integration",
    "test:integration:containers": "dotenv -e .env -- env USE_TESTCONTAINERS=1 NODE_ENV=test vitest run src/tests/integration",
    "test:pentest": "dotenv -e .env.pentest.example -- env USE_TESTCONTAINERS=1 PENTEST_MODE=true NODE_ENV=test vitest run src/tests/pentest",
    "test:security": "vitest run --exclude src/tests/integration/** src/shared/infra/http/app.security.spec.ts src/modules/payments/useCases/webhookSecurity.spec.ts",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --exclude src/tests/integration/**",
    "test:all": "npm run test:unit && npm run test:integration",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.1.0",
    "@google-cloud/storage": "^7.21.0",
    "@prisma/adapter-pg": "6.4.0",
    "@prisma/client": "6.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.9",
    "busboy": "^1.6.0",
    "dayjs": "^1.11.13",
    "disposable-email-domains": "^1.0.62",
    "fastify": "^4.26.2",
    "google-auth-library": "^11.0.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^3.1.0",
    "node-cron": "^4.6.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.18.1",
    "tsconfig-paths": "^4.2.0",
    "tsyringe": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.19.20",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.18.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "6.4.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  }
}
