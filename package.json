{
  "name": "barberqueue-backend",
  "version": "1.0.0",
  "main": "dist/shared/infra/http/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/shared/infra/http/server.ts",
    "dev:docker": "tsx watch src/shared/infra/http/server.ts",
    "build": "tsup src --out-dir dist",
    "start": "node dist/shared/infra/http/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.3.0",
    "@fastify/swagger-ui": "^5.0.1",
    "@google-cloud/storage": "^7.21.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "dayjs": "^1.11.13",
    "fastify": "^4.26.2",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^3.1.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "tsconfig-paths": "^4.2.0",
    "tsyringe": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.19.20",
    "@types/pg": "^8.18.0",
    "prisma": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  }
}
