# ─── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://barberqueue:barberqueue123@localhost:5432/barberqueue_db"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3333
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:3002,http://localhost:5173"

# ─── Mercado Pago ─────────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxx-xxxx
MERCADOPAGO_WEBHOOK_SECRET=seu-segredo-webhook

# ─── Google Cloud Storage ─────────────────────────────────────────────────────
# Nome do bucket. Será criado por scripts/setup-gcs.sh se não existir.
GCS_BUCKET_NAME=barberqueue-assets

# ID do projeto GCP (obtenha em: gcloud config get-value project)
GCS_PROJECT_ID=seu-project-id-aqui

# Região onde o bucket será criado (setup-gcs.sh usa esta variável)
GCS_REGION=us-central1

# Caminho absoluto para o JSON de credenciais da Service Account.
# - Para desenvolvimento local: aponte para o arquivo na sua máquina.
# - Para Docker: o docker-compose monta o arquivo em /run/secrets/gcs-key.json.
# - Para Cloud Run / GKE com Workload Identity: DEIXE EM BRANCO (usa ADC).
GCS_KEY_FILE_PATH=/caminho/absoluto/para/gcs-key.json

# E-mail da Service Account (preenchido automaticamente por create-service-account.sh)
GCS_SA_EMAIL=barberqueue-api@seu-project-id-aqui.iam.gserviceaccount.com
