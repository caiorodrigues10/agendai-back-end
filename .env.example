# =============================================================================
# Agenda Já - Environment Variables Template
# =============================================================================
# Copie para .env e preencha os valores reais
# NUNCA commite o arquivo .env real!

# =============================================================================
# DATABASE (fornecida pelo usuário)
# =============================================================================
# Formato Neon/Supabase: postgresql://user:password@host:5432/dbname?sslmode=require
# Formato local: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=""
# Em produção: conexão direta do Supabase, usada por Prisma Migrate.
DIRECT_URL=""
# Ajustes opcionais do pool PostgreSQL.
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
# Ative quando o provedor oferecer uma cadeia de certificados confiável no ambiente.
DB_SSL_REJECT_UNAUTHORIZED=false
# Usada somente pelo PostgreSQL incluído nos arquivos Docker Compose locais.
POSTGRES_PASSWORD=""

# =============================================================================
# REDIS (Upstash ou local)
# =============================================================================
# Formato Upstash: redis://default:password@host:6379
# Formato local: redis://localhost:6379
REDIS_URL=""

# =============================================================================
# AUTH (gere com: openssl rand -base64 48)
# =============================================================================
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
AUTH_COOKIE_SAME_SITE="none"
WEATHER_USER_AGENT="AgendaJa/1.4 (https://seu-dominio.com/contato)"

# =============================================================================
# SERVER
# =============================================================================
PORT=3333
NODE_ENV=development
# Produção: NODE_ENV=production

# Rate limit de /auth/login (padrão 10/min). Só é lido em
# NODE_ENV=development ou test; em produção é ignorado.
# LOGIN_RATE_LIMIT_MAX=60

# Papel do container: api, worker ou scheduler.
# Use serviços separados em produção. Execução local sem o entrypoint ainda
# aceita o valor legado "all".
PROCESS_ROLE="api"

# Somente o serviço API pode aplicar migrations. Em worker/scheduler use false.
# Habilite em exatamente uma instância da API durante o bootstrap/deploy.
RUN_MIGRATIONS="false"

# CORS - URLs permitidas (separadas por vírgula, sem espaços)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3003"

# Trust proxy (X-Forwarded-For). Quantos saltos existem entre a internet e
# esta API (load balancer/ingress: Render, NGINX, etc.). Sem isso, atrás de
# LB a API enxerga o IP do proxy e rate limit/brute force/audit logs
# compartilham a cota de todos os clientes. Use o número de hops (ex.: 1)
# ou os CIDRs do proxy; "true" confia em qualquer X-Forwarded-For e permite
# forjar o IP — evite em produção (a API avisa no boot). Padrão: desativado.
# TRUST_PROXY=1

# =============================================================================
# RENDER DE IMAGENS DE POSTS (worker thread pool)
# =============================================================================
# Threads dedicadas ao render SVG→PNG (clamp 1..16, padrão min(4, CPUs)).
POST_RENDER_WORKERS=4
# Limite fim-a-fim por render em ms (clamp 1000..120000, padrão 15000).
# Ao estourar, o worker preso é descartado e o erro vira 503.
POST_RENDER_TIMEOUT_MS=15000

# =============================================================================
# FRONTEND URL (opcional, padrão: http://localhost:3003)
# =============================================================================
FRONTEND_URL="http://localhost:3003"

# =============================================================================
# ASAAS (produção: https://api.asaas.com | sandbox: https://api-sandbox.asaas.com)
# =============================================================================
ASAAS_API_URL="https://api-sandbox.asaas.com"
ASAAS_API_KEY=""
# Gere token webhook: openssl rand -base64 32
ASAAS_WEBHOOK_TOKEN=""

# =============================================================================
# GOOGLE OAUTH
# =============================================================================
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# EMAIL (Resend)
# =============================================================================
RESEND_API_KEY=""
EMAIL_FROM="Agenda Já <noreply@seudominio.com>"
EMAIL_REPLY_TO=""
# Segredo usado para assinar tokens de unsubscribe dos emails.
EMAIL_UNSUBSCRIBE_SECRET=""

# Ledger/outbox unificado: disabled | shadow | active.
# Primeiro deploy em shadow; mude para active somente com o worker saudável.
NOTIFICATION_V2_MODE="disabled"
# JSON com chaves AES-256-GCM versionadas. Preserve chaves antigas por 7 dias.
# Ex.: {"v1":"<32 bytes em Base64>"}
NOTIFICATION_PAYLOAD_KEYS=""
NOTIFICATION_PAYLOAD_ACTIVE_KEY="v1"
# Chave HMAC de 32 bytes em Base64 para hash de destinatários.
NOTIFICATION_HASH_KEY=""

# =============================================================================
# WHATSAPP (Z-API ou Evolution API)
# =============================================================================
ZAPI_INSTANCE_ID=""
ZAPI_INSTANCE_TOKEN=""
ZAPI_CLIENT_TOKEN=""

# =============================================================================
# STORAGE (Google Cloud Storage - opcional)
# =============================================================================
GCS_BUCKET_NAME=""
GCS_PROJECT_ID=""
GCS_KEY_FILE_PATH=""

# =============================================================================
# GEMINI (AI para sugestões de posts - opcional)
# =============================================================================
# Gere uma chave gratuita em: https://aistudio.google.com/apikey
# Se deixar vazio, o sistema usa templates locais como fallback.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# =============================================================================
# OPENAI (fallback IA - opcional)
# =============================================================================
# Obtenha em: https://platform.openai.com/api-keys
# Modelo: gpt-4o-mini (custo baixo)
OPENAI_API_KEY=""

# =============================================================================
# ANTHROPIC (fallback IA - opcional)
# =============================================================================
# Obtenha em: https://console.anthropic.com/
# Modelo: Claude 3.5 Haiku
ANTHROPIC_API_KEY=""

# =============================================================================
# GROQ (fallback IA - opcional, gratuito)
# =============================================================================
# Obtenha em: https://console.groq.com/
# Modelo: Llama 3.3 70B
GROQ_API_KEY=""

# =============================================================================
# MISTRAL (fallback IA - opcional)
# =============================================================================
# Obtenha em: https://console.mistral.ai/
# Modelo: mistral-small
MISTRAL_API_KEY=""

# =============================================================================
# DEEPSEEK (fallback IA - opcional)
# =============================================================================
# Obtenha em: https://platform.deepseek.com/
# Modelo: deepseek-chat
DEEPSEEK_API_KEY=""

# =============================================================================
# ORDEM DOS PROVEDORES IA (opcional)
# =============================================================================
# Separado por vírgula. Se vazio, usa a ordem padrão:
# gemini,openai,anthropic,groq,mistral,deepseek
AI_PROVIDER_ORDER=""

# =============================================================================
# MONITORING (opcional)
# =============================================================================
SENTRY_DSN=""
OTEL_ENABLED="false"
OTEL_PROMETHEUS_PORT="9464"

# =============================================================================
# RECAPTCHA v3 (Google)
# =============================================================================
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_MIN_SCORE=0.5

# =============================================================================
# MERCADO PAGO (opcional)
# =============================================================================
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# =============================================================================
# ABACATEPAY (webhook secret obrigatório em produção)
# =============================================================================
ABACATEPAY_WEBHOOK_SECRET=""

# =============================================================================
# EVOLUTION API (WhatsApp alternativo - opcional)
# =============================================================================
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE_NAME=""

# =============================================================================
# WHATSAPP - Número de contato (opcional)
# =============================================================================
CONTACT_WHATSAPP=""

# =============================================================================
# LOGGING (opcional, padrão: debug em dev, info em produção)
# =============================================================================
LOG_LEVEL=""

# =============================================================================
# SEGURANÇA (dev only - NUNCA usar em produção)
# =============================================================================
# Chave de cifra (64 hex chars / 32 bytes) para dados sensiveis de integracoes.
INTEGRATION_ENCRYPTION_KEY=""
ALLOW_INSECURE_WEBHOOKS="false"

# =============================================================================
# PRODUTOS - RESERVAS PÚBLICAS
# =============================================================================
# Prazo de retenção de uma reserva de produto, em horas (padrão: 48).
# Não existe cron de expiração: a expiração é calculada a cada leitura (`expiresAt`).
PRODUCT_RESERVATION_RETENTION_HOURS="48"
