# ─── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://agendai:agendai123@localhost:5432/agendai_db"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3333
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:3002,http://localhost:3003,http://localhost:5173"

# ─── Frontend (return/completion URL do checkout AbacatePay) ──────────────────
FRONTEND_URL=http://localhost:5173

# ─── Mercado Pago ─────────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxx-xxxx
MERCADOPAGO_WEBHOOK_SECRET=seu-segredo-webhook
# Public key usada SOMENTE no frontend (VITE_MERCADOPAGO_PUBLIC_KEY) para
# tokenizar cartões no browser. Documentada aqui por referência — o backend
# não a utiliza. Obtenha em: https://www.mercadopago.com.br/developers/panel
MERCADOPAGO_PUBLIC_KEY=TEST-xxxx-xxxx

# ─── AbacatePay (link de pagamento / checkout hospedado) ──────────────────────
# Dashboard → Integrar → API Keys (chave v2)
ABACATEPAY_API_KEY=
# Secret do webhook (mín. 16 chars). Envie na query (?webhookSecret=...) OU
# no header X-Webhook-Secret. Nunca use o valor de exemplo em produção.
ABACATEPAY_WEBHOOK_SECRET=CHANGE_ME_generate_a_long_random_secret
# Opcional — sobrescreve a chave pública HMAC documentada pela AbacatePay
# (integridade do body; NÃO substitui o secret acima)
# ABACATEPAY_HMAC_PUBLIC_KEY=
# Somente localhost: pula secret/HMAC/confirmação via API (NUNCA em staging/prod)
# ALLOW_INSECURE_WEBHOOKS=true
# Permite webhooks/checkouts com devMode=true (sandbox Abacate)
# ABACATEPAY_ALLOW_DEV_MODE=true
# Endpoint a cadastrar no dashboard:
#   POST {API}/api/payments/webhook/abacate?webhookSecret=SEU_SECRET
# Eventos: checkout.completed, checkout.refunded, checkout.disputed, checkout.lost

# ─── Asaas (assinatura — suporta estorno PARCIAL) ─────────────────────────────
# https://docs.asaas.com — Painel → Integrações → API
ASAAS_API_KEY=
# Token de autenticação do webhook (gerado no painel Asaas, 32–255 chars).
# O Asaas envia no header `asaas-access-token`. NÃO use a API Key como token.
ASAAS_WEBHOOK_TOKEN=
# URL base da API. Padrão (produção): https://api.asaas.com
# Sandbox: https://api-sandbox.asaas.com
# ASAAS_API_URL=https://api-sandbox.asaas.com
# Endpoint a cadastrar no painel:
#   POST {API}/api/payments/webhook/asaas  (header asaas-access-token)
# Eventos: PAYMENT_CONFIRMED, PAYMENT_RECEIVED, PAYMENT_OVERDUE,
#          PAYMENT_REFUNDED, PAYMENT_CHARGEBACK_REQUESTED,
#          PAYMENT_CHARGEBACK_DISPUTE, PAYMENT_AWAITING_CHARGEBACK_REVERSAL

# ─── Google OAuth (SSO — login via Google Identity Services) ──────────────────
# Google Cloud Console → Credentials → OAuth 2.0 Client ID (tipo Web application)
# Mesmo Client ID usado no frontend (VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# ─── Google Cloud Storage ─────────────────────────────────────────────────────
# Guia completo: docs/GCS_SETUP.md
# 1) Preencha PROJECT_ID + BUCKET_NAME
# 2) bash scripts/create-service-account.sh
# 3) bash scripts/setup-gcs.sh
# 4) Local: GCS_KEY_FILE_PATH absoluto | Docker: ./gcs-key.json montado em /run/secrets/

# Nome do bucket (globalmente único). Será criado por scripts/setup-gcs.sh se não existir.
GCS_BUCKET_NAME=agendai-assets

# ID do projeto GCP (obtenha em: gcloud config get-value project)
GCS_PROJECT_ID=seu-project-id-aqui

# Região onde o bucket será criado (setup-gcs.sh usa esta variável)
GCS_REGION=us-central1

# Caminho absoluto para o JSON de credenciais da Service Account.
# - Desenvolvimento local: caminho absoluto até gcs-key.json no host.
# - Docker Compose: o compose sobrescreve para /run/secrets/gcs-key.json (mount de ./gcs-key.json).
# - Cloud Run / GKE com Workload Identity: DEIXE EM BRANCO (usa ADC).
GCS_KEY_FILE_PATH=/caminho/absoluto/para/gcs-key.json

# Alternativa ao arquivo: JSON puro ou base64 da service account (deixe KEY_FILE_PATH vazio).
# GCS_CREDENTIALS_JSON=

# URL base pública dos objetos (padrão: https://storage.googleapis.com/<bucket>).
# Só defina se usar CDN / domínio customizado no bucket.
# GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/agendai-assets

# E-mail da Service Account (preenchido automaticamente por create-service-account.sh)
GCS_SA_EMAIL=agendai-api@seu-project-id-aqui.iam.gserviceaccount.com

# ─── WhatsApp (Evolution API) ─────────────────────────────────────────────────
# Self-hosted: https://github.com/evolution-foundation/evolution-api
# Docs: https://docs.evolutionfoundation.com.br
# Sem estas vars, o envio só registra log (fila/agenda continuam funcionando).
# 1) Suba a Evolution API (Docker: evoapicloud/evolution-api:latest na porta 8080)
# 2) Crie uma instância e escaneie o QR Code com o WhatsApp que enviará avisos
# 3) Preencha URL base, API key (header apikey) e o nome da instância
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# WhatsApp da equipe para alertas do formulário público /contato (opcional)
CONTACT_WHATSAPP=

# Lembretes diários de agendamento: cron 08:00 America/Sao_Paulo
# Disparo manual (MASTER_ADMIN): POST /api/notifications/appointment-reminders/run

# ─── E-mail (Resend) ──────────────────────────────────────────────────────────
# https://resend.com — verifique o domínio (SPF/DKIM/DMARC) antes de produção.
# Sem RESEND_API_KEY o envio só registra log (cadastro continua funcionando).
RESEND_API_KEY=
# Ex.: AGENDAI <noreply@agendai.com.br>
EMAIL_FROM=
EMAIL_REPLY_TO=
# Em desenvolvimento, limite destinatários (lista separada por vírgula).
# EMAIL_ALLOWLIST=voce@email.com

# Redis (BullMQ — WhatsApp + e-mail). Já usado pelo worker de WhatsApp.
# REDIS_URL=redis://localhost:6379

