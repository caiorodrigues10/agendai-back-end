# ─── Banco de dados ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://barberqueue:barberqueue123@localhost:5432/barberqueue_db"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3333
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:3002,http://localhost:5173"

# ─── Mercado Pago ────────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxx-xxxx
MERCADOPAGO_WEBHOOK_SECRET=seu-segredo-webhook

# ─── Google Cloud Storage ────────────────────────────────────────────────────
# Nome do bucket criado no GCP (sem gs://)
GCS_BUCKET_NAME=barberqueue-assets

# ID do projeto no GCP
GCS_PROJECT_ID=seu-project-id-aqui

# Caminho absoluto para o JSON da Service Account
# Deixe vazio para usar ADC (Application Default Credentials):
#   gcloud auth application-default login
GCS_KEY_FILE_PATH=/caminho/absoluto/para/barberqueue-api-xxxx.json
