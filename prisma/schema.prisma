generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  name             String    @db.VarChar(200)
  email            String    @unique @db.VarChar(100)
  password         String    @db.VarChar(500)
  role             Role      @default(EMPLOYEE)
  barbershopId     String?   @db.Uuid
  cpf              String?   @unique @db.VarChar(11)
  emailVerified    Boolean   @default(false)
  googleSub        String?   @unique @db.VarChar(100)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  active           Boolean   @default(true)
  deletedAt        DateTime?
  termsVersion     String?   @db.VarChar(20)
  termsAcceptedAt  DateTime?
  marketingOptIn   Boolean   @default(false)
  marketingOptInAt DateTime?
  lgpdConsentAt    DateTime?
  avatarUrl        String?   @db.VarChar(500)
  permissions      String[]  @default([])

  barbershop               Barbershop?              @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  refreshTokens            RefreshToken[]
  appointments             Appointment[]            @relation("staff")
  feedPosts                FeedPost[]
  postMedia                PostMedia[]              @relation("PostMediaUploadedBy")
  referralCodes            ReferralCode[]
  referralsAsReferrer      Referral[]               @relation("ReferralReferrer")
  referralsAsReferee       Referral[]               @relation("ReferralReferee")
  verificationTokens       VerificationToken[]
  refunds                  Refund[]                 @relation("RefundRequestedBy")
  soldClientPackages       ClientPackage[]          @relation("PackageSoldBy")
  commissionEntries        CommissionEntry[]
  deletionRequests         AccountDeletionRequest[]
  notificationDeliveries   NotificationDelivery[]
  calendarBlocksAsStaff    CalendarBlock[]          @relation("CalendarBlockStaff")
  calendarBlocksCreated    CalendarBlock[]          @relation("CalendarBlockCreatedBy")
  appointmentSeriesCreated AppointmentSeries[]      @relation("AppointmentSeriesCreatedBy")
  clientReviewsAsStaff     ClientReview[]           @relation("ClientReviewStaff")
  professionalGoals        ProfessionalGoal[]
  depositConfirmations     AppointmentDeposit[]     @relation("DepositConfirmedBy")
  waitlistPreferredStaff   AppointmentWaitlistEntry[] @relation("WaitlistPreferredStaff")
  waitlistOfferStaff       AppointmentWaitlistOffer[] @relation("WaitlistOfferStaff")
  showcaseEntriesShowcased ShowcaseEntry[]            @relation("ShowcaseStaff")
  showcaseEntriesAuthorized ShowcaseEntry[]           @relation("ShowcaseAuthorizedBy")
   tabClosedTabs            VisitTab[]                @relation("TabClosedBy")
   confirmedLinks           ClientSalonLink[]         @relation("LinkConfirmedBy")
   rejectedLinks            ClientSalonLink[]         @relation("LinkRejectedBy")
    sentCareInstructions     ClientCareInstruction[]   @relation("CareInstructionSentBy")
    organizations            Organization[]
    orgMemberships           OrganizationMember[]
    staffSchedules           StaffSchedule[]
    staffServices            StaffService[]
    staffTimeOff             StaffTimeOff[]
    timeOffApproved          StaffTimeOff[]         @relation("TimeOffApprovedBy")
    qualityAudits            QualityAudit[]
    purchaseOrdersCreated    PurchaseOrder[]
    reviewResponses          ReviewResponse[]

  @@index([cpf])
  @@index([deletedAt])
  @@map("users")
}

enum Role {
  MASTER_ADMIN
  OWNER
  EMPLOYEE
  CUSTOMER // TODO: reservado para uso futuro (app de clientes). Não usado em lógicas atuais.
}

model AccountDeletionRequest {
  id          String                       @id @default(uuid()) @db.Uuid
  userId      String                       @db.Uuid
  status      AccountDeletionRequestStatus @default(PENDING)
  reason      String?                      @db.VarChar(500)
  requestedAt DateTime                     @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@map("account_deletion_requests")
}

enum AccountDeletionRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELED
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @db.VarChar(500)
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique @db.VarChar(100)
  userId    String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("verification_tokens")
}

enum PaymentMethodEnum {
  credit_card
  debit_card
  pix
  payment_link
}

enum PaymentProvider {
  MERCADOPAGO
  ABACATEPAY
  ASAAS
}

enum PaymentStatusEnum {
  pending
  approved
  authorized
  in_process
  in_mediation
  rejected
  cancelled
  refunded
  charged_back
}

model Payment {
  id                String            @id @default(uuid()) @db.Uuid
  mpPaymentId       BigInt?           @unique
  provider          PaymentProvider   @default(MERCADOPAGO)
  providerPaymentId String?           @unique @db.VarChar(128)
  checkoutUrl       String?           @db.VarChar(500)
  status            PaymentStatusEnum @default(pending)
  statusDetail      String            @db.VarChar(100)
  paymentMethod     PaymentMethodEnum
  transactionAmount Float             @db.Real
  currency          String            @default("BRL") @db.VarChar(5)
  description       String            @db.VarChar(256)
  barbershopId      String            @db.Uuid
  serviceId         String?           @db.Uuid
  appointmentId     String?           @db.Uuid
  queueItemId       String?           @db.Uuid
  externalReference String?           @db.VarChar(128)
  pixQrCode         String?           @db.Text
  pixQrCodeBase64   String?           @db.Text
  pixExpirationDate DateTime?
  rawResponse       String?           @db.Text
  /// Snapshot estritamente allowlisted do provedor. `rawResponse` e legado.
  providerSnapshot  Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  refunds    Refund[]

  @@index([barbershopId])
  @@index([status])
  @@index([mpPaymentId])
  @@index([providerPaymentId])
  @@index([externalReference])
  @@index([externalReference, status])
  @@map("payments")
}

enum OperationMode {
  QUEUE_ONLY
  APPOINTMENTS_ONLY
  HYBRID
}

enum ManualShopStatus {
  AUTO
  OPEN
  CLOSED
}

enum OpeningMode {
  SCHEDULE
  MANUAL
}

enum BusinessSegment {
  BARBERSHOP
  HAIR_SALON
  BEAUTY_STUDIO
  NAIL_STUDIO
  LASH_BROW_STUDIO
  AESTHETICS
  SPA
  OTHER
}

model Barbershop {
  id                    String           @id @default(uuid()) @db.Uuid
  name                  String           @db.VarChar(200)
  whatsapp              String           @db.VarChar(20)
  logoUrl               String?          @db.VarChar(500)
  cnpj                  String?          @db.VarChar(20)
  address               String?          @db.Text
  city                  String?          @db.VarChar(120)
  latitude              Float?
  longitude             Float?
  operationMode         OperationMode    @default(HYBRID)
  timezone              String           @default("America/Sao_Paulo") @db.VarChar(64)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  active                Boolean          @default(true)
  approvalStatus        ApprovalStatus   @default(PENDING)
  rejectionReason       String?          @db.Text
  /// Nome da instância da Evolution API conectada ao WhatsApp desta barbearia.
  /// Se vazio, cai no fallback da env var EVOLUTION_INSTANCE_NAME.
  evolutionInstanceName String?          @db.VarChar(100)
  queueAlertEnabled     Boolean          @default(false)
  queueAlertThreshold   Int              @default(10)
  queueAlertPhone       String?          @db.VarChar(20)
  queueAlertUpdatedAt   DateTime?
  /// Código de indicação que trouxe este salão (dono→dono).
   referredByCodeId      String?          @db.Uuid
   organizationId        String?          @db.Uuid
  /// Publicação automática de posts no horário de abertura (Schedule.openTime).
  autoPostEnabled       Boolean          @default(false)
  /// Última data em que o auto-post foi disparado (evita duplicidade no mesmo dia).
  autoPostLastDate      DateTime?
  /// AUTO segue a agenda; OPEN/CLOSED sobrescrevem o dia (OPEN expira no fim do dia).
  manualStatus          ManualShopStatus @default(AUTO)
  manualStatusSetAt     DateTime?
  /// Fila fechada manualmente (expira no dia seguinte, timezone do salão).
  queueClosedAt         DateTime?
  /// SCHEDULE abre pelo horário; MANUAL só abre quando o dono aperta "Abrir salão".
  openingMode           OpeningMode      @default(SCHEDULE)
  /// Nicho do estabelecimento — só orienta templates; não altera permissões nem URLs.
  businessSegment       BusinessSegment  @default(OTHER)

  onboardingCompletedSteps String[]
  onboardingCurrentStep    String?
  onboardingStartedAt      DateTime?
  onboardingCompletedAt    DateTime?

  schedules                Schedule[]
  services                 Service[]
  users                    User[]
  queue                    QueueItem[]
  appointments             Appointment[]
  feedPosts                FeedPost[]
  postMedia                PostMedia[]
  subscriptions            Subscription[]
  payments                 Payment[]
  serviceCategories        ServiceCategory[]
  expenseCategories        ExpenseCategory[]
  expenses                 Expense[]
  fiados                   Fiado[]
  referralCodes            ReferralCode[]
  referredByCode           ReferralCode?             @relation("ReferredByCode", fields: [referredByCodeId], references: [id], onDelete: SetNull)
  referralsAsReferrer      Referral[]                @relation("ReferralReferrerShop")
  referralsAsReferee       Referral[]                @relation("ReferralRefereeShop")
  refunds                  Refund[]
  salonClients             SalonClient[]
  servicePackages          ServicePackage[]
  clientPackages           ClientPackage[]
  dailyWeatherLogs         DailyWeatherLog[]
  CommissionEntry          CommissionEntry[]
  crmFinancialEvents       CrmFinancialEvent[]
  crmCampaigns             CrmCampaign[]
  crmBackfillRuns          CrmBackfillRun[]
  onboarding               BarbershopOnboarding?
  notificationDeliveries   NotificationDelivery[]
  notificationPreferences  NotificationPreference[]
  notificationSuppressions NotificationSuppression[]
  scheduleExceptions       ScheduleException[]
  calendarBlocks           CalendarBlock[]
  appointmentPolicies      AppointmentPolicy?
  appointmentSeries        AppointmentSeries[]
  clientReviews            ClientReview[]
  products                 Product[]
  productCategories        ProductCategory[]
  suppliers                Supplier[]
  stockMovements           StockMovement[]
  inventoryReceipts        InventoryReceipt[]
  retailSales              RetailSale[]
  catalogTemplateInstalls  CatalogTemplateInstall[]
  dailyCloseouts           DailyCloseout[]
  activationMetrics        ActivationMetric[]
  cashMovements            CashMovement[]
  loyaltyProgram           LoyaltyProgram?
  loyaltyAccounts          LoyaltyAccount[]
  professionalGoals        ProfessionalGoal[]
  appointmentDeposits      AppointmentDeposit[]
  waitlistEntries          AppointmentWaitlistEntry[]
  waitlistOffers           AppointmentWaitlistOffer[]
  membershipPlans          SalonMembershipPlan[]
  clientMemberships        ClientMembership[]
  showcaseEntries          ShowcaseEntry[]
  showcaseEvents           ShowcaseEvent[]
  combos                   ServiceCombo[]
  visits                   Visit[]
   visitTabs                VisitTab[]
   clientLinks              ClientSalonLink[]
   careInstructionTemplates CareInstructionTemplate[]
   clientCareInstructions   ClientCareInstruction[]
   giftCards                GiftCard[]
    resources                Resource[]
    resourceBookings         ResourceBooking[]
    profitEntries            ProfitEntry[]
     profitSettings           ProfitSettings?
     organization             Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
     customForms              CustomForm[]
     staffSchedules           StaffSchedule[]
     staffServices            StaffService[]
     staffTimeOff             StaffTimeOff[]
     pricingRules             PricingRule[]
     vouchers                 Voucher[]
     qualityProtocols         QualityProtocol[]
     purchaseOrders           PurchaseOrder[]
     copilotSuggestions       CopilotSuggestion[]
     salonReputation          SalonReputation?
     formResponses            FormResponse[]
     qualityAudits            QualityAudit[]
     corporateSubscriptions   CorporateSubscription[]

     @@index([approvalStatus])
   @@index([active])
   @@index([referredByCodeId])
   @@map("barbershops")
}

model BarbershopOnboarding {
  id                       String    @id @default(uuid()) @db.Uuid
  barbershopId             String    @unique @db.Uuid
  profileConfirmedAt       DateTime?
  scheduleConfirmedAt      DateTime?
  servicesConfirmedAt      DateTime?
  publicLinkValidatedAt    DateTime?
  whatsappConfiguredAt     DateTime?
  firstServiceCompletedAt  DateTime?
  welcomeSeenAt            DateTime?
  operationModeConfirmedAt DateTime?
  segmentConfirmedAt       DateTime?
  dismissedAt              DateTime?
  completedAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@map("barbershop_onboardings")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Schedule {
  id           String  @id @default(uuid()) @db.Uuid
  barbershopId String  @db.Uuid
  dayOfWeek    Int
  isOpen       Boolean @default(false)
  openTime     String  @db.VarChar(5)
  closeTime    String  @db.VarChar(5)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, dayOfWeek])
  @@map("schedules")
}

model AppointmentPolicy {
  id                         String              @id @default(uuid()) @db.Uuid
  barbershopId               String              @unique @db.Uuid
  bookingNoticeMinutes       Int                 @default(60)
  cancelNoticeMinutes        Int                 @default(120)
  rescheduleNoticeMinutes    Int                 @default(120)
  bookingHorizonDays         Int                 @default(60)
  allowPublicCancellation    Boolean             @default(true)
  allowPublicReschedule      Boolean             @default(true)
  requestReview              Boolean             @default(true)
  depositRequired            DepositRequiredMode @default(OFF)
  depositDefaultPercent      Float               @default(30) @db.Real
  depositDefaultAmount       Decimal?            @db.Decimal(12,2)
  depositConfirmHours        Int                 @default(2)
  depositInstructions        String?             @db.Text
  depositPixKey              String?             @db.VarChar(100)
  depositRefundRule          RefundRule          @default(FULL_REFUND)
  noShowDepositRule          RefundRule          @default(NO_REFUND)
  maxReschedules             Int                 @default(2)
  rescheduleTransferDeposit  Boolean             @default(true)
  lateToleranceMinutes       Int                 @default(15)
  riskThresholdNoShows       Int                 @default(3)
  riskBlockDurationDays      Int                 @default(30)
  riskReinforcedDeposit      Boolean             @default(false)
  riskManualApproval         Boolean             @default(false)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@map("appointment_policies")
}

model ScheduleException {
  id           String   @id @default(uuid()) @db.Uuid
  barbershopId String   @db.Uuid
  date         DateTime @db.Date
  isOpen       Boolean  @default(false)
  openTime     String?  @db.VarChar(5)
  closeTime    String?  @db.VarChar(5)
  reason       String?  @db.VarChar(200)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, date])
  @@index([barbershopId, date])
  @@map("schedule_exceptions")
}

enum CalendarBlockRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model CalendarBlock {
  id              String                  @id @default(uuid()) @db.Uuid
  barbershopId    String                  @db.Uuid
  staffId         String?                 @db.Uuid
  startAt         DateTime
  endAt           DateTime
  reason          String                  @db.VarChar(200)
  recurrence      CalendarBlockRecurrence @default(NONE)
  recurrenceUntil DateTime?
  createdById     String                  @db.Uuid
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  staff      User?      @relation("CalendarBlockStaff", fields: [staffId], references: [id], onDelete: SetNull)
  createdBy  User       @relation("CalendarBlockCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([barbershopId, startAt, endAt])
  @@index([staffId, startAt, endAt])
  @@map("calendar_blocks")
}

model AppointmentSeries {
  id              String   @id @default(uuid()) @db.Uuid
  barbershopId    String   @db.Uuid
  intervalWeeks   Int      @default(1)
  occurrenceCount Int
  startDate       DateTime @db.Date
  createdById     String   @db.Uuid
  createdAt       DateTime @default(now())

  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("AppointmentSeriesCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@index([barbershopId, startDate])
  @@map("appointment_series")
}

model Service {
  id                String   @id @default(uuid()) @db.Uuid
  barbershopId      String   @db.Uuid
  categoryId        String?  @db.Uuid
  name              String   @db.VarChar(100)
  price             Float    @db.Real
  avgTimeMinutes    Int
  icon              String   @db.VarChar(50)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  active            Boolean  @default(true)
  commissionPercent Float    @default(0) @db.Real

  barbershop        Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  category          ServiceCategory?  @relation("ServiceToCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  queue             QueueItem[]
  appointments      Appointment[]
  servicePackages   ServicePackage[]
  clientPackages    ClientPackage[]
  commissionEntries CommissionEntry[]
  depositOverrides  AppointmentDeposit[]
  membershipBenefits MembershipBenefit[]
  waitlistEntries   AppointmentWaitlistEntry[]
  variations        ServiceVariation[]
  addons            ServiceAddon[]
  showcaseEntries   ShowcaseEntry[]
  careInstructionTemplates CareInstructionTemplate[]
  comboItems        ComboItem[]
  staffServices     StaffService[]

  @@map("services")
}

model QueueItem {
  id                     String      @id @default(uuid()) @db.Uuid
  barbershopId           String      @db.Uuid
  serviceId              String      @db.Uuid
  customerId             String      @db.Uuid
  customerName           String      @db.VarChar(200)
  whatsapp               String      @db.VarChar(20)
  joinedAt               DateTime    @default(now())
  /// Momento em que o cliente foi chamado para a cadeira; usado para medir espera.
  calledAt               DateTime?
  status                 QueueStatus @default(WAITING)
  estimatedStartAt       DateTime?
  /// Última posição notificada ao cliente (evita reenvio se a posição não mudou)
  lastNotifiedPosition   Int?
  addedByStaff           Boolean     @default(false)
  completedAt            DateTime?
  completedBy            String?     @db.Uuid
  finalPrice             Float?      @db.Real
  paymentMethod          String?     @db.VarChar(50)
    appointmentId     String?             @unique     @db.Uuid
  /// Cliente do CRM. customerId continua sendo apenas a sessão/dispositivo público.
  clientId               String?     @db.Uuid
  responsibleQueueItemId String?     @db.Uuid
  activeIdentityKey      String?     @db.VarChar(500)

  barbershop           Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  service              Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  appointment          Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  client               SalonClient?      @relation("ClientQueueItems", fields: [clientId], references: [id], onDelete: SetNull)
  responsibleQueueItem QueueItem?        @relation("QueueDependents", fields: [responsibleQueueItemId], references: [id], onDelete: SetNull)
  dependents           QueueItem[]       @relation("QueueDependents")
  commissionEntries    CommissionEntry[]
  retailSales          RetailSale[]

  @@index([appointmentId])
  @@index([clientId])
  @@index([responsibleQueueItemId])
  @@index([activeIdentityKey])
  @@map("queue")
}

/// Lançamento imutável de comissão gerado ao concluir um atendimento da fila.
model CommissionEntry {
  id             String   @id @default(uuid()) @db.Uuid
  barbershopId   String   @db.Uuid
  queueItemId    String   @db.Uuid
  serviceId      String   @db.Uuid
  professionalId String   @db.Uuid
  percentage     Float    @db.Real
  amount         Float    @db.Real
  createdAt      DateTime @default(now())

  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  queueItem    QueueItem  @relation(fields: [queueItemId], references: [id], onDelete: Cascade)
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  professional User       @relation(fields: [professionalId], references: [id], onDelete: Restrict)

  @@unique([queueItemId, professionalId])
  @@index([barbershopId, createdAt])
  @@index([professionalId, createdAt])
  @@map("commission_entries")
}

enum QueueStatus {
  WAITING
  IN_CHAIR
  COMPLETED
  CANCELLED
}

model Appointment {
  id                  String                         @id @default(uuid()) @db.Uuid
  barbershopId        String                         @db.Uuid
  serviceId           String                         @db.Uuid
  staffId             String?                        @db.Uuid
  clientId            String?                        @db.Uuid
  clientPackageId     String?                        @db.Uuid
  customerName        String                         @db.VarChar(200)
  whatsapp            String                         @db.VarChar(20)
  date                DateTime                       @db.Date
  time                String                         @db.VarChar(5)
  status              AppointmentStatus              @default(CONFIRMED)
  /// Quando o lembrete diário de WhatsApp foi enviado (evita duplicidade)
  reminderSentAt      DateTime?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  publicAccessVersion Int                            @default(1)
  rescheduledFromId   String?                        @db.Uuid
  canceledAt          DateTime?
  cancellationSource  AppointmentCancellationSource?
  cancellationReason  String?                        @db.VarChar(300)
  seriesId            String?                        @db.Uuid
  occurrenceIndex     Int?
  depositStatus      DepositStatus?
  depositExpiry      DateTime?
  noShowMarkedAt     DateTime?
  noShowMarkedById   String?                        @db.Uuid
  visitId            String?                        @db.Uuid

  barbershop      Barbershop         @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  service         Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff           User?              @relation("staff", fields: [staffId], references: [id], onDelete: SetNull)
  client          SalonClient?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientPackage   ClientPackage?     @relation(fields: [clientPackageId], references: [id], onDelete: SetNull)
  series          AppointmentSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  rescheduledFrom Appointment?       @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Appointment[]      @relation("AppointmentReschedule")
  review          ClientReview?
  queueItems      QueueItem[]
  retailSales     RetailSale[]
  deposit         AppointmentDeposit?
  waitlistOffers  AppointmentWaitlistOffer[]
  membershipUsages MembershipUsage[]
  tabItem          TabItem?
   visit            Visit?             @relation(fields: [visitId], references: [id], onDelete: SetNull)
   careInstructions ClientCareInstruction[]
   resourceBookings ResourceBooking[]

  @@index([barbershopId, staffId, date, status])
  @@index([clientId])
  @@index([clientPackageId])
  @@index([seriesId, occurrenceIndex])
  @@index([visitId])
  @@map("appointments")
}

enum AppointmentCancellationSource {
  STAFF
  CUSTOMER
  SYSTEM
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  CHECKED_IN
  NO_SHOW
}

enum PackagePaymentMethod {
  cash
  pix
  card
  other
}

enum ClientPackageStatus {
  ACTIVE
  DEPLETED
  EXPIRED
  CANCELLED
}

/// Cliente do salão (CRM por tenant). Identidade: WhatsApp único no estabelecimento.
model SalonClient {
  id                   String    @id @default(uuid()) @db.Uuid
  barbershopId         String    @db.Uuid
  name                 String    @db.VarChar(200)
  /// Contato exibido. Pode ficar vazio para registros criados sem telefone.
  whatsapp             String    @default("") @db.VarChar(20)
  /// Chave normalizada (DDD + telefone); nula quando o cliente não informou WhatsApp.
  normalizedWhatsapp   String?   @db.VarChar(11)
  notes                String?   @db.Text
  marketingOptIn       Boolean   @default(false)
  marketingOptInAt     DateTime?
  marketingOptInSource String?   @db.VarChar(80)
