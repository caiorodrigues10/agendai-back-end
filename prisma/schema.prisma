/// Canais suportados pelo ledger unificado. Novos tipos de mensagem usam
/// `NotificationDelivery.type` (string) e nao exigem migration.
enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationDeliveryStatus {
  PENDING
  QUEUED
  PROCESSING
  RETRYING
  SENT
  DELIVERED
  READ
  FAILED
  BOUNCED
  COMPLAINED
  SUPPRESSED
  SKIPPED
  CANCELED
}

enum NotificationOutboxStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum NotificationAttemptStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

enum NotificationProviderEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model NotificationDelivery {
  id                  String                     @id @default(uuid()) @db.Uuid
  barbershopId        String?                    @db.Uuid
  clientId            String?                    @db.Uuid
  userId              String?                    @db.Uuid
  campaignRecipientId String?                    @unique @db.Uuid
  channel             NotificationChannel
  type                String                     @db.VarChar(80)
  templateKey         String?                    @db.VarChar(100)
  templateVersion     Int                        @default(1)
  status              NotificationDeliveryStatus @default(PENDING)
  idempotencyKey      String                     @db.VarChar(180)
  destinationMasked   String                     @db.VarChar(200)
  destinationHash     String                     @db.VarChar(64)
  contentHash         String                     @db.VarChar(64)
  provider            String?                    @db.VarChar(40)
  providerId          String?                    @db.VarChar(160)
  errorCode           String?                    @db.VarChar(100)
  errorMessage        String?                    @db.VarChar(500)
  attemptCount        Int                        @default(0)
  sourceType          String?                    @db.VarChar(80)
  sourceId            String?                    @db.VarChar(160)
  retryOfId           String?                    @db.Uuid
  queuedAt            DateTime?
  processingAt        DateTime?
  sentAt              DateTime?
  deliveredAt         DateTime?
  readAt              DateTime?
  delayedAt           DateTime?
  openedAt            DateTime?
  clickedAt           DateTime?
  failedAt            DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  barbershop        Barbershop?                 @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  client            SalonClient?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user              User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaignRecipient CrmCampaignRecipient?       @relation(fields: [campaignRecipientId], references: [id], onDelete: SetNull)
  retryOf           NotificationDelivery?       @relation("NotificationRetries", fields: [retryOfId], references: [id], onDelete: SetNull)
  retries           NotificationDelivery[]      @relation("NotificationRetries")
  outbox            NotificationOutbox?
  attempts          NotificationAttempt[]
  providerEvents    NotificationProviderEvent[]

  @@unique([channel, idempotencyKey])
  @@index([barbershopId, createdAt])
  @@index([barbershopId, status, createdAt])
  @@index([provider, providerId])
  @@index([destinationHash, createdAt])
  @@index([sourceType, sourceId])
  @@map("notification_deliveries")
}

model NotificationOutbox {
  id                String                   @id @default(uuid()) @db.Uuid
  deliveryId        String                   @unique @db.Uuid
  status            NotificationOutboxStatus @default(PENDING)
  payloadCiphertext String                   @db.Text
  payloadIv         String                   @db.VarChar(32)
  payloadTag        String                   @db.VarChar(32)
  keyVersion        String                   @db.VarChar(32)
  publishAttempts   Int                      @default(0)
  nextAttemptAt     DateTime                 @default(now())
  lockedAt          DateTime?
  lockedBy          String?                  @db.VarChar(100)
  publishedAt       DateTime?
  lastError         String?                  @db.VarChar(500)
  purgeAfter        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  delivery NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([lockedAt])
  @@index([purgeAfter])
  @@map("notification_outbox")
}

model NotificationAttempt {
  id             String                    @id @default(uuid()) @db.Uuid
  deliveryId     String                    @db.Uuid
  attemptNumber  Int
  status         NotificationAttemptStatus @default(PROCESSING)
  providerId     String?                   @db.VarChar(160)
  providerStatus String?                   @db.VarChar(100)
  httpStatus     Int?
  errorCode      String?                   @db.VarChar(100)
  errorMessage   String?                   @db.VarChar(500)
  startedAt      DateTime                  @default(now())
  completedAt    DateTime?

  delivery NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNumber])
  @@index([status, startedAt])
  @@map("notification_attempts")
}

model NotificationProviderEvent {
  id               String                          @id @default(uuid()) @db.Uuid
  deliveryId       String?                         @db.Uuid
