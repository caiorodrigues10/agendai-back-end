generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  name             String    @db.VarChar(200)
  email            String    @unique @db.VarChar(100)
  password         String    @db.VarChar(500)
  role             Role      @default(EMPLOYEE)
  barbershopId     String?   @db.Uuid
  cpf              String?   @unique @db.VarChar(11)
  emailVerified    Boolean   @default(false)
  googleSub        String?   @unique @db.VarChar(100)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  active           Boolean   @default(true)
  deletedAt        DateTime?
  termsVersion     String?   @db.VarChar(20)
  termsAcceptedAt  DateTime?
  marketingOptIn   Boolean   @default(false)
  marketingOptInAt DateTime?
  lgpdConsentAt    DateTime?
  avatarUrl        String?   @db.VarChar(500)
  permissions      String[]  @default([])

  barbershop             Barbershop?              @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  refreshTokens          RefreshToken[]
  appointments           Appointment[]            @relation("staff")
  feedPosts              FeedPost[]
  postMedia              PostMedia[] @relation("PostMediaUploadedBy")
  referralCodes          ReferralCode[]
  referralsAsReferrer    Referral[]               @relation("ReferralReferrer")
  referralsAsReferee     Referral[]               @relation("ReferralReferee")
  verificationTokens     VerificationToken[]
  refunds                Refund[]                 @relation("RefundRequestedBy")
  soldClientPackages     ClientPackage[]          @relation("PackageSoldBy")
  commissionEntries      CommissionEntry[]
  deletionRequests       AccountDeletionRequest[]
  notificationDeliveries NotificationDelivery[]

  @@index([cpf])
  @@index([deletedAt])
  @@map("users")
}

enum Role {
  MASTER_ADMIN
  OWNER
  EMPLOYEE
  CUSTOMER // TODO: reservado para uso futuro (app de clientes). Não usado em lógicas atuais.
}

model AccountDeletionRequest {
  id          String                       @id @default(uuid()) @db.Uuid
  userId      String                       @db.Uuid
  status      AccountDeletionRequestStatus @default(PENDING)
  reason      String?                      @db.VarChar(500)
  requestedAt DateTime                     @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@map("account_deletion_requests")
}

enum AccountDeletionRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELED
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @db.VarChar(500)
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique @db.VarChar(100)
  userId    String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("verification_tokens")
}

enum PaymentMethodEnum {
  credit_card
  debit_card
  pix
  payment_link
}

enum PaymentProvider {
  MERCADOPAGO
  ABACATEPAY
  ASAAS
}

enum PaymentStatusEnum {
  pending
  approved
  authorized
  in_process
  in_mediation
  rejected
  cancelled
  refunded
  charged_back
}

model Payment {
  id                String            @id @default(uuid()) @db.Uuid
  mpPaymentId       BigInt?           @unique
  provider          PaymentProvider   @default(MERCADOPAGO)
  providerPaymentId String?           @unique @db.VarChar(128)
  checkoutUrl       String?           @db.VarChar(500)
  status            PaymentStatusEnum @default(pending)
  statusDetail      String            @db.VarChar(100)
  paymentMethod     PaymentMethodEnum
  transactionAmount Float             @db.Real
  currency          String            @default("BRL") @db.VarChar(5)
  description       String            @db.VarChar(256)
  barbershopId      String            @db.Uuid
  serviceId         String?           @db.Uuid
  appointmentId     String?           @db.Uuid
  queueItemId       String?           @db.Uuid
  externalReference String?           @db.VarChar(128)
  pixQrCode         String?           @db.Text
  pixQrCodeBase64   String?           @db.Text
  pixExpirationDate DateTime?
  rawResponse       String?           @db.Text
  /// Snapshot estritamente allowlisted do provedor. `rawResponse` e legado.
  providerSnapshot  Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  refunds    Refund[]

  @@index([barbershopId])
  @@index([status])
  @@index([mpPaymentId])
  @@index([providerPaymentId])
  @@index([externalReference])
  @@index([externalReference, status])
  @@map("payments")
}

enum OperationMode {
  QUEUE_ONLY
  APPOINTMENTS_ONLY
  HYBRID
}

model Barbershop {
  id                    String         @id @default(uuid()) @db.Uuid
  name                  String         @db.VarChar(200)
  whatsapp              String         @db.VarChar(20)
  logoUrl               String?        @db.VarChar(500)
  cnpj                  String?        @db.VarChar(20)
  address               String?        @db.Text
  city                  String?        @db.VarChar(120)
  latitude              Float?
  longitude             Float?
  operationMode         OperationMode  @default(HYBRID)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  active                Boolean        @default(true)
  approvalStatus        ApprovalStatus @default(PENDING)
  rejectionReason       String?        @db.Text
  /// Nome da instância da Evolution API conectada ao WhatsApp desta barbearia.
  /// Se vazio, cai no fallback da env var EVOLUTION_INSTANCE_NAME.
  evolutionInstanceName String?        @db.VarChar(100)
  /// Código de indicação que trouxe este salão (dono→dono).
  referredByCodeId      String?        @db.Uuid
  /// Publicação automática de posts no horário de abertura (Schedule.openTime).
  autoPostEnabled       Boolean        @default(false)
  /// Última data em que o auto-post foi disparado (evita duplicidade no mesmo dia).
  autoPostLastDate      DateTime?

  schedules                Schedule[]
  services                 Service[]
  users                    User[]
  queue                    QueueItem[]
  appointments             Appointment[]
  feedPosts                FeedPost[]
  postMedia                PostMedia[]
  subscriptions            Subscription[]
  payments                 Payment[]
  serviceCategories        ServiceCategory[]
  expenseCategories        ExpenseCategory[]
  expenses                 Expense[]
  fiados                   Fiado[]
  referralCodes            ReferralCode[]
  referredByCode           ReferralCode?             @relation("ReferredByCode", fields: [referredByCodeId], references: [id], onDelete: SetNull)
  referralsAsReferrer      Referral[]                @relation("ReferralReferrerShop")
  referralsAsReferee       Referral[]                @relation("ReferralRefereeShop")
  refunds                  Refund[]
  salonClients             SalonClient[]
  servicePackages          ServicePackage[]
  clientPackages           ClientPackage[]
  dailyWeatherLogs         DailyWeatherLog[]
  CommissionEntry          CommissionEntry[]
  crmFinancialEvents       CrmFinancialEvent[]
  crmCampaigns             CrmCampaign[]
  crmBackfillRuns          CrmBackfillRun[]
  onboarding               BarbershopOnboarding?
  notificationDeliveries   NotificationDelivery[]
  notificationPreferences  NotificationPreference[]
  notificationSuppressions NotificationSuppression[]

  @@index([approvalStatus])
  @@index([active])
  @@index([referredByCodeId])
  @@map("barbershops")
}

model BarbershopOnboarding {
  id                      String    @id @default(uuid()) @db.Uuid
  barbershopId            String    @unique @db.Uuid
  profileConfirmedAt      DateTime?
  scheduleConfirmedAt     DateTime?
  servicesConfirmedAt     DateTime?
  publicLinkValidatedAt   DateTime?
  whatsappConfiguredAt    DateTime?
  firstServiceCompletedAt DateTime?
  completedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@map("barbershop_onboardings")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Schedule {
  id           String  @id @default(uuid()) @db.Uuid
  barbershopId String  @db.Uuid
  dayOfWeek    Int
  isOpen       Boolean @default(false)
  openTime     String  @db.VarChar(5)
  closeTime    String  @db.VarChar(5)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, dayOfWeek])
  @@map("schedules")
}

model Service {
  id                String   @id @default(uuid()) @db.Uuid
  barbershopId      String   @db.Uuid
  categoryId        String?  @db.Uuid
  name              String   @db.VarChar(100)
  price             Float    @db.Real
  avgTimeMinutes    Int
  icon              String   @db.VarChar(50)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  active            Boolean  @default(true)
  commissionPercent Float    @default(0) @db.Real

  barbershop        Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  category          ServiceCategory?  @relation("ServiceToCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  queue             QueueItem[]
  appointments      Appointment[]
  servicePackages   ServicePackage[]
  clientPackages    ClientPackage[]
  commissionEntries CommissionEntry[]

  @@map("services")
}

model QueueItem {
  id                     String      @id @default(uuid()) @db.Uuid
  barbershopId           String      @db.Uuid
  serviceId              String      @db.Uuid
  customerId             String      @db.Uuid
  customerName           String      @db.VarChar(200)
  whatsapp               String      @db.VarChar(20)
  joinedAt               DateTime    @default(now())
  /// Momento em que o cliente foi chamado para a cadeira; usado para medir espera.
  calledAt               DateTime?
  status                 QueueStatus @default(WAITING)
  estimatedStartAt       DateTime?
  /// Última posição notificada ao cliente (evita reenvio se a posição não mudou)
  lastNotifiedPosition   Int?
  addedByStaff           Boolean     @default(false)
  completedAt            DateTime?
  completedBy            String?     @db.Uuid
  finalPrice             Float?      @db.Real
  paymentMethod          String?     @db.VarChar(50)
  appointmentId          String?     @db.Uuid
  /// Cliente do CRM. customerId continua sendo apenas a sessão/dispositivo público.
  clientId               String?     @db.Uuid
  responsibleQueueItemId String?     @db.Uuid
  activeIdentityKey      String?     @db.VarChar(500)

  barbershop           Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  service              Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  appointment          Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  client               SalonClient?      @relation("ClientQueueItems", fields: [clientId], references: [id], onDelete: SetNull)
  responsibleQueueItem QueueItem?        @relation("QueueDependents", fields: [responsibleQueueItemId], references: [id], onDelete: SetNull)
  dependents           QueueItem[]       @relation("QueueDependents")
  commissionEntries    CommissionEntry[]

  @@index([appointmentId])
  @@index([clientId])
  @@index([responsibleQueueItemId])
  @@index([activeIdentityKey])
  @@map("queue")
}

/// Lançamento imutável de comissão gerado ao concluir um atendimento da fila.
model CommissionEntry {
  id             String   @id @default(uuid()) @db.Uuid
  barbershopId   String   @db.Uuid
  queueItemId    String   @db.Uuid
  serviceId      String   @db.Uuid
  professionalId String   @db.Uuid
  percentage     Float    @db.Real
  amount         Float    @db.Real
  createdAt      DateTime @default(now())

  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  queueItem    QueueItem  @relation(fields: [queueItemId], references: [id], onDelete: Cascade)
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  professional User       @relation(fields: [professionalId], references: [id], onDelete: Restrict)

  @@unique([queueItemId, professionalId])
  @@index([barbershopId, createdAt])
  @@index([professionalId, createdAt])
  @@map("commission_entries")
}

enum QueueStatus {
  WAITING
  IN_CHAIR
  COMPLETED
  CANCELLED
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  barbershopId    String            @db.Uuid
  serviceId       String            @db.Uuid
  staffId         String?           @db.Uuid
  clientId        String?           @db.Uuid
  clientPackageId String?           @db.Uuid
  customerName    String            @db.VarChar(200)
  whatsapp        String            @db.VarChar(20)
  date            DateTime          @db.Date
  time            String            @db.VarChar(5)
  status          AppointmentStatus @default(CONFIRMED)
  /// Quando o lembrete diário de WhatsApp foi enviado (evita duplicidade)
  reminderSentAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  barbershop    Barbershop     @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff         User?          @relation("staff", fields: [staffId], references: [id], onDelete: SetNull)
  client        SalonClient?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientPackage ClientPackage? @relation(fields: [clientPackageId], references: [id], onDelete: SetNull)
  queueItems    QueueItem[]

  @@index([barbershopId, staffId, date, status])
  @@index([clientId])
  @@index([clientPackageId])
  @@map("appointments")
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  CHECKED_IN
  NO_SHOW
}

enum PackagePaymentMethod {
  cash
  pix
  card
  other
}

enum ClientPackageStatus {
  ACTIVE
  DEPLETED
  EXPIRED
  CANCELLED
}

/// Cliente do salão (CRM por tenant). Identidade: WhatsApp único no estabelecimento.
model SalonClient {
  id                   String    @id @default(uuid()) @db.Uuid
  barbershopId         String    @db.Uuid
  name                 String    @db.VarChar(200)
  /// Contato exibido. Pode ficar vazio para registros criados sem telefone.
  whatsapp             String    @default("") @db.VarChar(20)
  /// Chave normalizada (DDD + telefone); nula quando o cliente não informou WhatsApp.
  normalizedWhatsapp   String?   @db.VarChar(11)
  notes                String?   @db.Text
  marketingOptIn       Boolean   @default(false)
  marketingOptInAt     DateTime?
  marketingOptInSource String?   @db.VarChar(80)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  barbershop             Barbershop             @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  packages               ClientPackage[]
  appointments           Appointment[]
  queueItems             QueueItem[]            @relation("ClientQueueItems")
  fiados                 Fiado[]
  financialEvents        CrmFinancialEvent[]
  campaignRecipients     CrmCampaignRecipient[]
  notificationDeliveries NotificationDelivery[]

  @@unique([barbershopId, normalizedWhatsapp])
  @@index([barbershopId])
  @@index([whatsapp])
  @@map("salon_clients")
}

/// Catálogo de pacote pré-pago vendido pelo salão (ex.: 5 cortes).
model ServicePackage {
  id           String   @id @default(uuid()) @db.Uuid
  barbershopId String   @db.Uuid
  serviceId    String   @db.Uuid
  name         String   @db.VarChar(100)
  sessionCount Int
  price        Float    @db.Real
  validityDays Int?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop     Barbershop      @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  clientPackages ClientPackage[]

  @@index([barbershopId])
  @@index([serviceId])
  @@index([active])
  @@map("service_packages")
}

/// Pacote vendido a uma cliente — carteira de sessões.
model ClientPackage {
  id                String               @id @default(uuid()) @db.Uuid
  barbershopId      String               @db.Uuid
  clientId          String               @db.Uuid
  packageId         String               @db.Uuid
  serviceId         String               @db.Uuid
  totalSessions     Int
  remainingSessions Int
  pricePaid         Float                @db.Real
  paymentMethod     PackagePaymentMethod
  status            ClientPackageStatus  @default(ACTIVE)
  purchasedAt       DateTime             @default(now())
  expiresAt         DateTime?
  soldById          String?              @db.Uuid
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  barbershop   Barbershop     @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  client       SalonClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  package      ServicePackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  service      Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  soldBy       User?          @relation("PackageSoldBy", fields: [soldById], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([barbershopId])
  @@index([clientId])
  @@index([status])
  @@index([expiresAt])
  @@map("client_packages")
}

model FeedPost {
  id           String         @id @default(uuid()) @db.Uuid
  barbershopId String         @db.Uuid
  authorId     String?        @db.Uuid
  type         FeedType
  title        String?        @db.VarChar(200)
  content      String         @db.Text
  // Text: o front envia data-URLs base64 (até migrar para upload GCS)
  imageUrl     String?        @db.Text
  /// URL do vídeo no GCS (pasta posts/).
  videoUrl     String?        @db.Text
  likes        Int            @default(0)
  /// Agendamento de publicação: NULL = publicado imediatamente (rascunho se status DRAFT).
  scheduledFor DateTime?
  /// Timestamp real da publicação (preenchido pelo cron quando status vira PUBLISHED).
  publishedAt  DateTime?
  status       FeedPostStatus @default(DRAFT)
  /// Para onde o CTA do post direciona o cliente: fila, agenda ou ambos.
  postMode     PostMode       @default(BOTH)
  /// Texto do CTA exibido no post (ex.: "Agende seu horário").
  ctaText      String?        @db.VarChar(120)
  templateKey  String         @default("agenda-aberta") @db.VarChar(64)
  format       PostFormat     @default(SQUARE)
  primaryMediaId   String?    @db.Uuid
  secondaryMediaId String?    @db.Uuid
  paletteKey   String         @default("brand") @db.VarChar(32)
  designOptions Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  author     User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  primaryMedia   PostMedia? @relation("PrimaryPostMedia", fields: [primaryMediaId], references: [id], onDelete: SetNull)
  secondaryMedia PostMedia? @relation("SecondaryPostMedia", fields: [secondaryMediaId], references: [id], onDelete: SetNull)

  @@index([barbershopId, status, scheduledFor])
  @@map("feed_posts")
}

enum PostFormat {
  SQUARE
  PORTRAIT
  STORY
}

model PostMedia {
  id           String   @id @default(uuid()) @db.Uuid
  barbershopId String   @db.Uuid
  uploadedById String?  @db.Uuid
  url          String   @db.Text
  objectName   String   @db.Text
  mimeType     String   @db.VarChar(80)
  size         Int
  createdAt    DateTime @default(now())
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  uploadedBy   User? @relation("PostMediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  primaryPosts FeedPost[] @relation("PrimaryPostMedia")
  secondaryPosts FeedPost[] @relation("SecondaryPostMedia")
  @@index([barbershopId, createdAt])
  @@map("post_media")
}

enum FeedPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum PostMode {
  QUEUE
  APPOINTMENTS
  BOTH
}

enum FeedType {
  HAIRCUT
  BEARD
  ANNOUNCEMENT
}

enum PlanBillingCycle {
  MONTHLY
  YEARLY
}

enum ReferralTier {
  BRONZE
  SILVER
  GOLD
}

model Plan {
  id               String           @id @default(uuid()) @db.Uuid
  name             String           @db.VarChar(100)
  description      String?          @db.Text
  price            Float            @db.Real
  billingCycle     PlanBillingCycle @default(MONTHLY)
  /// 0 = funcionários ilimitados
  maxEmployees     Int              @default(0)
  /// Relatórios / financeiro / insights (dashboard analítico do staff)
  hasDashboard     Boolean          @default(true)
  /// Agrupa mensal/anual do mesmo produto (essential | pro)
  tierKey          String           @default("pro") @db.VarChar(40)
  features         String[]
  abacateProductId String?          @db.VarChar(64)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  active           Boolean          @default(true)

  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([billingCycle])
  @@index([tierKey])
  @@index([hasDashboard])
  @@map("plans")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  barbershopId         String             @db.Uuid
  planId               String             @db.Uuid
  status               SubscriptionStatus @default(TRIALING)
  startDate            DateTime           @default(now())
  endDate              DateTime?
  cancelDate           DateTime?
  /// Motivo do cancelamento informado pelo dono (quando aplicável).
  cancelReason         String?            @db.VarChar(50)
  /// Dias acumulados via programa de indicação (auditoria).
  referralCreditDays   Int                @default(0)
  /// Cliente Asaas (para cobrança pós-trial com cartão vaulted).
  asaasCustomerId      String?            @db.VarChar(64)
  /// Token do cartão Asaas (POST /v3/creditCard/tokenize) — sem cobrança no cadastro.
  asaasCreditCardToken String?            @db.VarChar(128)
  cardLast4            String?            @db.VarChar(4)
  cardBrand            String?            @db.VarChar(32)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  plan       Plan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices   Invoice[]

  @@unique([barbershopId])
  @@index([status])
  @@index([barbershopId, status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  TRIALING
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  subscriptionId String        @db.Uuid
  /// Plano solicitado nesta cobrança. A troca só entra em vigor após o pagamento aprovado.
  planId         String?       @db.Uuid
  amount         Float         @db.Real
  dueDate        DateTime
  paidAt         DateTime?
  status         InvoiceStatus @default(PENDING)
  paymentMethod  String?       @db.VarChar(50)
  idempotencyKey String?       @db.VarChar(100)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan         Plan?        @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@unique([subscriptionId, idempotencyKey])
  @@index([status])
  @@index([dueDate])
  @@index([subscriptionId, status, dueDate])
  @@index([planId])
  @@map("invoices")
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model BlockedEntity {
  id           String            @id @default(uuid()) @db.Uuid
  type         BlockedEntityType
  value        String            @db.VarChar(20)
  reason       String            @db.VarChar(500)
  blockedAt    DateTime          @default(now())
  unblockedAt  DateTime?
  isActive     Boolean           @default(true)
  barbershopId String?           @db.Uuid
  blockedBy    String?           @db.VarChar(50)
  unblockedBy  String?           @db.VarChar(50)
  externalRef  String?           @db.VarChar(128)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([type, value])
  @@index([isActive])
  @@index([barbershopId])
