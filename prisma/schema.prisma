generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  name              String    @db.VarChar(200)
  email             String    @unique @db.VarChar(100)
  password          String    @db.VarChar(500)
  role              Role      @default(EMPLOYEE)
  barbershopId      String?   @db.Uuid
  cpf               String?   @unique @db.VarChar(11)
  emailVerified     Boolean   @default(false)
  googleSub         String?   @unique @db.VarChar(100)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  active            Boolean   @default(true)
  deletedAt         DateTime?
  termsVersion      String?   @db.VarChar(20)
  termsAcceptedAt   DateTime?
  marketingOptIn    Boolean   @default(false)
  marketingOptInAt  DateTime?
  lgpdConsentAt     DateTime?

  barbershop          Barbershop?         @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  refreshTokens       RefreshToken[]
  appointments        Appointment[]       @relation("staff")
  feedPosts           FeedPost[]
  referralCodes       ReferralCode[]
  referralsAsReferrer Referral[]          @relation("ReferralReferrer")
  referralsAsReferee  Referral[]          @relation("ReferralReferee")
  verificationTokens  VerificationToken[]
  refunds             Refund[]            @relation("RefundRequestedBy")
  soldClientPackages  ClientPackage[]     @relation("PackageSoldBy")

  @@map("users")
  @@index([cpf])
  @@index([deletedAt])
}

enum Role {
  MASTER_ADMIN
  OWNER
  EMPLOYEE
  CUSTOMER  // TODO: reservado para uso futuro (app de clientes). Não usado em lógicas atuais.
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @db.VarChar(500)
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique @db.VarChar(100)
  userId    String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
  @@index([token])
  @@index([userId])
}

enum PaymentMethodEnum {
  credit_card
  debit_card
  pix
  payment_link
}

enum PaymentProvider {
  MERCADOPAGO
  ABACATEPAY
  ASAAS
}

enum PaymentStatusEnum {
  pending
  approved
  authorized
  in_process
  in_mediation
  rejected
  cancelled
  refunded
  charged_back
}

model Payment {
  id                String            @id @default(uuid()) @db.Uuid
  mpPaymentId       BigInt?           @unique
  provider          PaymentProvider   @default(MERCADOPAGO)
  providerPaymentId String?           @unique @db.VarChar(128)
  checkoutUrl       String?           @db.VarChar(500)
  status            PaymentStatusEnum @default(pending)
  statusDetail      String            @db.VarChar(100)
  paymentMethod     PaymentMethodEnum
  transactionAmount Float             @db.Real
  currency          String            @default("BRL") @db.VarChar(5)
  description       String            @db.VarChar(256)
  barbershopId      String            @db.Uuid
  serviceId         String?           @db.Uuid
  appointmentId     String?           @db.Uuid
  queueItemId       String?           @db.Uuid
  externalReference String?           @db.VarChar(128)
  pixQrCode         String?           @db.Text
  pixQrCodeBase64   String?           @db.Text
  pixExpirationDate DateTime?
  rawResponse       String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  refunds    Refund[]

  @@map("payments")
  @@index([barbershopId])
  @@index([status])
  @@index([mpPaymentId])
  @@index([providerPaymentId])
  @@index([externalReference])
  @@index([externalReference, status])
}

model Barbershop {
  id              String         @id @default(uuid()) @db.Uuid
  name            String         @db.VarChar(200)
  whatsapp        String         @db.VarChar(20)
  logoUrl         String?        @db.VarChar(500)
  cnpj            String?        @db.VarChar(20)
  address         String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  active          Boolean        @default(true)
  approvalStatus  ApprovalStatus @default(PENDING)
  rejectionReason String?        @db.Text
  /// Nome da instância da Evolution API conectada ao WhatsApp desta barbearia.
  /// Se vazio, cai no fallback da env var EVOLUTION_INSTANCE_NAME.
  evolutionInstanceName String? @db.VarChar(100)
  /// Código de indicação que trouxe este salão (dono→dono).
  referredByCodeId String? @db.Uuid
  /// Publicação automática de posts no horário de abertura (Schedule.openTime).
  autoPostEnabled Boolean   @default(false)
  /// Última data em que o auto-post foi disparado (evita duplicidade no mesmo dia).
  autoPostLastDate DateTime?

  schedules         Schedule[]
  services          Service[]
  users             User[]
  queue             QueueItem[]
  appointments      Appointment[]
  feedPosts         FeedPost[]
  subscriptions     Subscription[]
  payments          Payment[]
  serviceCategories ServiceCategory[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  fiados            Fiado[]
  referralCodes     ReferralCode[]
  referredByCode    ReferralCode? @relation("ReferredByCode", fields: [referredByCodeId], references: [id], onDelete: SetNull)
  referralsAsReferrer Referral[] @relation("ReferralReferrerShop")
  referralsAsReferee  Referral[] @relation("ReferralRefereeShop")
  refunds             Refund[]
  salonClients        SalonClient[]
  servicePackages     ServicePackage[]
  clientPackages      ClientPackage[]

  @@map("barbershops")
  @@index([approvalStatus])
  @@index([active])
  @@index([referredByCodeId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Schedule {
  id           String  @id @default(uuid()) @db.Uuid
  barbershopId String  @db.Uuid
  dayOfWeek    Int
  isOpen       Boolean @default(false)
  openTime     String  @db.VarChar(5)
  closeTime    String  @db.VarChar(5)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, dayOfWeek])
  @@map("schedules")
}

model Service {
  id             String   @id @default(uuid()) @db.Uuid
  barbershopId   String   @db.Uuid
  categoryId     String?  @db.Uuid
  name           String   @db.VarChar(100)
  price          Float    @db.Real
  avgTimeMinutes Int
  icon           String   @db.VarChar(50)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  active         Boolean  @default(true)

  barbershop      Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  category        ServiceCategory? @relation("ServiceToCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  queue           QueueItem[]
  appointments    Appointment[]
  servicePackages ServicePackage[]
  clientPackages  ClientPackage[]

  @@map("services")
}

model QueueItem {
  id               String      @id @default(uuid()) @db.Uuid
  barbershopId     String      @db.Uuid
  serviceId        String      @db.Uuid
  customerId       String      @db.Uuid
  customerName     String      @db.VarChar(200)
  whatsapp         String      @db.VarChar(20)
  joinedAt         DateTime    @default(now())
  status           QueueStatus @default(WAITING)
  estimatedStartAt     DateTime?
  /// Última posição notificada ao cliente (evita reenvio se a posição não mudou)
  lastNotifiedPosition Int?
  addedByStaff     Boolean     @default(false)
  completedAt      DateTime?
  completedBy      String?     @db.Uuid
  finalPrice       Float?      @db.Real

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@map("queue")
}

enum QueueStatus {
  WAITING
  IN_CHAIR
  COMPLETED
  CANCELLED
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  barbershopId    String            @db.Uuid
  serviceId       String            @db.Uuid
  staffId         String?           @db.Uuid
  clientId        String?           @db.Uuid
  clientPackageId String?           @db.Uuid
  customerName    String            @db.VarChar(200)
  whatsapp        String            @db.VarChar(20)
  date            DateTime          @db.Date
  time            String            @db.VarChar(5)
  status          AppointmentStatus @default(CONFIRMED)
  /// Quando o lembrete diário de WhatsApp foi enviado (evita duplicidade)
  reminderSentAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  barbershop    Barbershop     @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff         User?          @relation("staff", fields: [staffId], references: [id], onDelete: SetNull)
  client        SalonClient?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientPackage ClientPackage? @relation(fields: [clientPackageId], references: [id], onDelete: SetNull)

  @@index([barbershopId, staffId, date, status])
  @@index([clientId])
  @@index([clientPackageId])
  @@map("appointments")
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PackagePaymentMethod {
  cash
  pix
  card
  other
}

enum ClientPackageStatus {
  ACTIVE
  DEPLETED
  EXPIRED
  CANCELLED
}

/// Cliente do salão (CRM por tenant). Identidade: WhatsApp único no estabelecimento.
model SalonClient {
  id           String   @id @default(uuid()) @db.Uuid
  barbershopId String   @db.Uuid
  name         String   @db.VarChar(200)
  whatsapp     String   @db.VarChar(20)
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop   Barbershop      @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  packages     ClientPackage[]
  appointments Appointment[]

  @@unique([barbershopId, whatsapp])
  @@index([barbershopId])
  @@index([whatsapp])
  @@map("salon_clients")
}

/// Catálogo de pacote pré-pago vendido pelo salão (ex.: 5 cortes).
model ServicePackage {
  id           String   @id @default(uuid()) @db.Uuid
  barbershopId String   @db.Uuid
  serviceId    String   @db.Uuid
  name         String   @db.VarChar(100)
  sessionCount Int
  price        Float    @db.Real
  validityDays Int?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop     Barbershop      @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  clientPackages ClientPackage[]

  @@index([barbershopId])
  @@index([serviceId])
  @@index([active])
  @@map("service_packages")
}

/// Pacote vendido a uma cliente — carteira de sessões.
model ClientPackage {
  id                String               @id @default(uuid()) @db.Uuid
  barbershopId      String               @db.Uuid
  clientId          String               @db.Uuid
  packageId         String               @db.Uuid
  serviceId         String               @db.Uuid
  totalSessions     Int
  remainingSessions Int
  pricePaid         Float                @db.Real
  paymentMethod     PackagePaymentMethod
  status            ClientPackageStatus  @default(ACTIVE)
  purchasedAt       DateTime             @default(now())
  expiresAt         DateTime?
  soldById          String?              @db.Uuid
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  barbershop   Barbershop     @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  client       SalonClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  package      ServicePackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  service      Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  soldBy       User?          @relation("PackageSoldBy", fields: [soldById], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([barbershopId])
  @@index([clientId])
  @@index([status])
  @@index([expiresAt])
  @@map("client_packages")
}

model FeedPost {
  id           String   @id @default(uuid()) @db.Uuid
  barbershopId String   @db.Uuid
  authorId     String?  @db.Uuid
  type         FeedType
  title        String?  @db.VarChar(200)
  content      String   @db.Text
  // Text: o front envia data-URLs base64 (até migrar para upload GCS)
  imageUrl     String?  @db.Text
  /// URL do vídeo no GCS (pasta posts/).
  videoUrl     String?  @db.Text
  likes        Int      @default(0)
  /// Agendamento de publicação: NULL = publicado imediatamente (rascunho se status DRAFT).
  scheduledFor DateTime?
  /// Timestamp real da publicação (preenchido pelo cron quando status vira PUBLISHED).
  publishedAt  DateTime?
  status       FeedPostStatus @default(DRAFT)
  /// Para onde o CTA do post direciona o cliente: fila, agenda ou ambos.
  postMode     PostMode       @default(BOTH)
  /// Texto do CTA exibido no post (ex.: "Agende seu horário").
  ctaText      String?        @db.VarChar(120)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  author     User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("feed_posts")
  @@index([barbershopId, status, scheduledFor])
}

enum FeedPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum PostMode {
  QUEUE
  APPOINTMENTS
  BOTH
}

enum FeedType {
  HAIRCUT
  BEARD
  ANNOUNCEMENT
}

enum PlanBillingCycle {
  MONTHLY
  YEARLY
}

enum ReferralTier {
  BRONZE
  SILVER
  GOLD
}

model Plan {
  id               String           @id @default(uuid()) @db.Uuid
  name             String           @db.VarChar(100)
  description      String?          @db.Text
  price            Float            @db.Real
  billingCycle     PlanBillingCycle @default(MONTHLY)
  /// 0 = funcionários ilimitados
  maxEmployees     Int              @default(0)
  /// Relatórios / financeiro / insights (dashboard analítico do staff)
  hasDashboard     Boolean          @default(true)
  /// Agrupa mensal/anual do mesmo produto (essential | pro)
  tierKey          String           @default("pro") @db.VarChar(40)
  features         String[]
  abacateProductId String?          @db.VarChar(64)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  active           Boolean          @default(true)

  subscriptions Subscription[]

  @@map("plans")
  @@index([billingCycle])
  @@index([tierKey])
  @@index([hasDashboard])
}

model Subscription {
  id           String             @id @default(uuid()) @db.Uuid
  barbershopId String             @db.Uuid
  planId       String             @db.Uuid
  status       SubscriptionStatus @default(TRIALING)
  startDate    DateTime           @default(now())
  endDate      DateTime?
  cancelDate   DateTime?
  /// Motivo do cancelamento informado pelo dono (quando aplicável).
  cancelReason String?            @db.VarChar(50)
  /// Dias acumulados via programa de indicação (auditoria).
  referralCreditDays Int          @default(0)
  /// Cliente Asaas (para cobrança pós-trial com cartão vaulted).
  asaasCustomerId       String?   @db.VarChar(64)
  /// Token do cartão Asaas (POST /v3/creditCard/tokenize) — sem cobrança no cadastro.
  asaasCreditCardToken  String?   @db.VarChar(128)
  cardLast4             String?   @db.VarChar(4)
  cardBrand             String?   @db.VarChar(32)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  plan       Plan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices   Invoice[]

  @@unique([barbershopId])
  @@map("subscriptions")
  @@index([status])
  @@index([barbershopId, status])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  subscriptionId String        @db.Uuid
  amount         Float         @db.Real
  dueDate        DateTime
  paidAt         DateTime?
  status         InvoiceStatus @default(PENDING)
  paymentMethod  String?       @db.VarChar(50)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("invoices")
  @@index([status])
  @@index([dueDate])
  @@index([subscriptionId, status, dueDate])
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model BlockedEntity {
  id           String            @id @default(uuid()) @db.Uuid
  type         BlockedEntityType
  value        String            @db.VarChar(20)
  reason       String            @db.VarChar(500)
  blockedAt    DateTime          @default(now())
  unblockedAt  DateTime?
  isActive     Boolean           @default(true)
  barbershopId String?           @db.Uuid
  blockedBy    String?           @db.VarChar(50)
  unblockedBy  String?           @db.VarChar(50)
  externalRef  String?           @db.VarChar(128)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("blocked_entities")
  @@index([type, value])
  @@index([isActive])
  @@index([barbershopId])
}

enum BlockedEntityType {
  CPF
  CNPJ
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentId        String       @db.Uuid
  barbershopId     String       @db.Uuid
  amount           Int
  reason           String       @db.VarChar(500)
  status           RefundStatus @default(PENDING)
  provider         PaymentProvider
  providerRefundId String?      @db.VarChar(128)
  requestedById    String?      @db.Uuid
  errorMessage     String?      @db.Text
  createdAt        DateTime     @default(now())
  completedAt      DateTime?

  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  requestedBy User?    @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@map("refunds")
  @@index([paymentId])
  @@index([barbershopId])
  @@index([status])
}

model AdminNotification {
  id        String                @id @default(uuid()) @db.Uuid
  type      AdminNotificationType
  title     String                @db.VarChar(200)
  message   String                @db.Text
  read      Boolean               @default(false)
  metadata  String?               @db.Text
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@map("admin_notifications")
  @@index([read])
  @@index([type])
  @@index([createdAt])
}

enum AdminNotificationType {
  BLOCK_AUTO
  UNBLOCK_AUTO
  UNBLOCK_MANUAL
  SUBSCRIPTION_EXPIRED
  PAYMENT_RECEIVED
  PAYMENT_REFUNDED
  CONTACT_MESSAGE
  REFERRAL_REVOKED
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(100)
  resourceId String?  @db.VarChar(100)
  details    String?  @db.Text
  ipAddress  String?  @db.VarChar(50)
  createdAt  DateTime @default(now())

  @@map("audit_logs")
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model AccessLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  email      String?  @db.VarChar(255)
  action     String   @db.VarChar(50)   // LOGIN, LOGOUT, LOGIN_FAILED, REFRESH, REGISTER
  ipAddress  String?  @db.VarChar(50)
  userAgent  String?  @db.VarChar(500)
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("access_logs")
  @@index([userId])
  @@index([email])
  @@index([action])
  @@index([createdAt])
}

model ErrorLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  statusCode Int
  code       String?  @db.VarChar(100)
  message    String   @db.Text
  stack      String?  @db.Text
  path       String   @db.VarChar(500)
  method     String   @db.VarChar(10)
  ipAddress  String?  @db.VarChar(50)
  createdAt  DateTime @default(now())

  @@map("error_logs")
  @@index([userId])
  @@index([statusCode])
  @@index([createdAt])
}

model ServiceCategory {
  id           String   @id @default(uuid()) @db.Uuid
  barbershopId String?  @db.Uuid
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  icon         String?  @db.VarChar(50)
  color        String?  @db.VarChar(7)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop Barbershop? @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  services   Service[]   @relation("ServiceToCategory")

  @@map("service_categories")
  @@index([barbershopId])
  @@index([active])
}

model ExpenseCategory {
  id           String   @id @default(uuid()) @db.Uuid
  barbershopId String?  @db.Uuid
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  icon         String?  @db.VarChar(50)
  color        String?  @db.VarChar(7)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop Barbershop? @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  expenses   Expense[]

  @@map("expense_categories")
  @@index([barbershopId])
}

model Expense {
  id            String            @id @default(uuid()) @db.Uuid
  barbershopId  String            @db.Uuid
  categoryId    String?           @db.Uuid
  title         String            @db.VarChar(200)
  description   String?           @db.Text
  amount        Float             @db.Real
  type          ExpenseType       @default(VARIABLE)
  recurrence    ExpenseRecurrence @default(ONCE)
  referenceDate DateTime
  paidAt        DateTime?
  dueDate       DateTime?
  paymentMethod String?           @db.VarChar(50)
  supplierName  String?           @db.VarChar(200)
  receiptUrl    String?           @db.VarChar(500)
  notes         String?           @db.Text
  createdById   String            @db.Uuid
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  barbershop Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("expenses")
  @@index([barbershopId])
  @@index([categoryId])
  @@index([referenceDate])
  @@index([paidAt])
  @@index([type])
}

enum ExpenseType {
  FIXED
  VARIABLE
  INVESTMENT
}

enum ExpenseRecurrence {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Fiado {
  id             String      @id @default(uuid()) @db.Uuid
  barbershopId   String      @db.Uuid
  customerName   String      @db.VarChar(200)
  whatsapp       String      @db.VarChar(20)
  description    String      @db.VarChar(500)
  originalAmount Float       @db.Real
  paidAmount     Float       @default(0) @db.Real
  status         FiadoStatus @default(PENDING)
  dueDate        DateTime?
  notes          String?     @db.Text
  createdById    String      @db.Uuid
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  barbershop Barbershop     @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  payments   FiadoPayment[]

  @@map("fiados")
  @@index([barbershopId])
  @@index([status])
  @@index([whatsapp])
  @@index([dueDate])
}

enum FiadoStatus {
  PENDING
  PARTIAL
  PAID
  FORGIVEN
}

model FiadoPayment {
  id             String   @id @default(uuid()) @db.Uuid
  fiadoId        String   @db.Uuid
  amount         Float    @db.Real
  notes          String?  @db.Text
  registeredById String   @db.Uuid
  createdAt      DateTime @default(now())

  fiado Fiado @relation(fields: [fiadoId], references: [id], onDelete: Cascade)

  @@map("fiado_payments")
  @@index([fiadoId])
}

/// Código de indicação dono→dono (um por salão, gerado sob demanda).
model ReferralCode {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique @db.VarChar(32)
  ownerUserId  String       @db.Uuid
  barbershopId String       @db.Uuid
  active       Boolean      @default(true)
  maxUses      Int?
  tier         ReferralTier @default(BRONZE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  ownerUser           User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  barbershop          Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  referrals           Referral[]
  referredBarbershops Barbershop[] @relation("ReferredByCode")

  @@map("referral_codes")
  @@index([ownerUserId])
  @@index([barbershopId])
  @@index([active])
}

model Referral {
  id                   String         @id @default(uuid()) @db.Uuid
  referralCodeId       String         @db.Uuid
  referrerUserId       String         @db.Uuid
  referrerBarbershopId String         @db.Uuid
  refereeUserId        String         @db.Uuid
  refereeBarbershopId  String         @db.Uuid
  refereeEmail         String         @db.VarChar(100)
  status               ReferralStatus @default(PENDING)
  rewardDays           Int            @default(30)
  qualifiedAt          DateTime?
  rewardedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  referralCode       ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  referrerUser       User         @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  refereeUser        User         @relation("ReferralReferee", fields: [refereeUserId], references: [id], onDelete: Cascade)
  referrerBarbershop Barbershop   @relation("ReferralReferrerShop", fields: [referrerBarbershopId], references: [id], onDelete: Cascade)
  refereeBarbershop  Barbershop   @relation("ReferralRefereeShop", fields: [refereeBarbershopId], references: [id], onDelete: Cascade)

  @@unique([refereeBarbershopId])
  @@map("referrals")
  @@index([referralCodeId])
  @@index([referrerUserId, status])
  @@index([status])
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  REJECTED
}

model EmailDelivery {
  id         String              @id @default(uuid()) @db.Uuid
  to         String              @db.VarChar(200)
  template   String              @db.VarChar(64)
  subject    String              @db.VarChar(200)
  status     EmailDeliveryStatus @default(PENDING)
  providerId String?             @db.VarChar(128)
  error      String?             @db.Text
  metadata   String?             @db.Text
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@map("email_deliveries")
  @@index([to])
  @@index([template])
  @@index([status])
  @@index([createdAt])
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Feedback {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@map("feedbacks")
  @@index([userId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @db.VarChar(100)
  token     String   @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
  @@index([email])
  @@index([token])
}
